{
  "log": {
    "disabled": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "bootstrap"
      },
      {
        "type": "https",
        "tag": "remote",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        },
        "detour": "vpn"
      }
    ],
    "rules": [
      {
        "query_type": "AAAA",
        "action": "predefined",
        "rcode": "NOERROR"
      }
    ],
    "final": "remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tv-tun",
      "interface_name": "vvpn0",
      "address": ["172.30.254.1/30", "fd00:766e::1/126"],
      "mtu": 1400,
      "auto_route": true,
      "auto_redirect": false,
      "strict_route": false,
      "iproute2_table_index": 22032,
      "iproute2_rule_index": 29100,
      "route_exclude_address": ["224.0.0.0/4", "ff00::/8"],
      "stack": "system"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "bootstrap",
    "rules": [
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "final": "vpn"
  }
}
